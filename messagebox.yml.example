# Mesaĝkesto configuration
# Copy this file to messagebox.yml and adjust the values.

# Directory for KEL and message database storage (redb).
db_path: "./db/"

# Directory for OOBI storage.
oobi_path: "./oobi/"

# HTTP listen port.
http_port: 8080

# Public URL used to advertise this messagebox via OOBI.
# Must be reachable by other KERI actors.
public_url: "http://localhost:8080/"

# Ed25519 keypair seed (CESR-encoded, e.g. "AK8F6AAiYDpNlW...").
# If omitted, a random key is generated on each start.
# seed: "AK8F6AAiYDpNlW..."

# Firebase Cloud Messaging server key for push notifications.
# Required — the server will not start without it.
server_key: "<your-firebase-server-key>"

# Watcher OOBI as JSON. The messagebox uses the watcher to
# fetch KEL updates for signature verification.
watcher_oobi: '{"eid":"BBilc4-L3tFUnfM_wJr4S4OJanAv_VmF_dJNN6vkf2Ha","scheme":"http","url":"http://watcher.example.com/"}'

# DauthZ state directory. When set, enables the authentication
# endpoints (/auth/challenge, /auth/respond, /auth/session)
# and authenticated mailbox/ACL/WebSocket endpoints.
# Comment out to run in unauthenticated relay-only mode.
dauthz_state_dir: "./dauthz/"

# Shared secret for signing MQTT JWT tokens (HS256).
# Must match the MESAGKESTO_JWT_SECRET environment variable configured
# in EMQX. Default for development: "mesagkesto-dev-secret-change-me".
# In production, use a strong random secret or switch to RS256.
jwt_secret: "mesagkesto-dev-secret-change-me"

# MQTT broker WebSocket URL. When set, the auth response includes
# an mqtt_token (JWT) and this URL so clients can connect to EMQX
# for real-time messaging instead of HTTP polling.
mqtt_url: "ws://localhost:8083/mqtt"

# Registration mode: "public" (default) or "invite_only".
# In public mode, anyone with a KERI AID can register.
# In invite_only mode, registration requires a valid invite token
# or the AID must be in the server's whitelist.
# registration_mode: "public"

# Admin AID — the KERI identifier granted admin privileges.
# When set, this AID's mailbox is auto-provisioned at startup.
# The admin authenticates via normal DauthZ challenge/response
# and can then manage invite tokens and the AID whitelist
# via /admin/* endpoints.
# admin_aid: "DAID..."
